# Copy this file to `.env` and fill in real values.
# Never commit `.env` — only commit this example.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_LEGACY_ANON_JWT

# Groq key does NOT go here. Set GROQ_API_KEY as an Edge Function secret:
#   npx supabase login
#   npx supabase link --project-ref YOUR_PROJECT_REF
#   npx supabase secrets set GROQ_API_KEY=gsk_...
#   npx supabase functions deploy soilgood-insights
